# Adapt /srv/voice-studio and User before installing this unit.
[Unit]
Description=Voice Comparison Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voice-studio
WorkingDirectory=/srv/voice-studio/backend
Environment=APP_ENV=production
Environment=VOICE_STUDIO_DATA=/srv/voice-studio/data
Environment=VOICE_STUDIO_MODEL_CACHE=/srv/voice-studio/models
Environment=HF_HOME=/srv/voice-studio/models/hf
Environment=TTS_HOME=/srv/voice-studio/models/tts
Environment=COSY_MODEL_DIR=/srv/voice-studio/models/cosyvoice3
Environment=QWEN_MODEL_DIR=/srv/voice-studio/models/qwen3
Environment=EVAL_MODELS_DIR=/srv/voice-studio/models/evaluators
Environment=SCOREQ_CACHE=/srv/voice-studio/models/scoreq
Environment=XDG_CACHE_HOME=/srv/voice-studio/models/cache
UMask=0077
EnvironmentFile=/srv/voice-studio/backend/.env
ExecStart=/srv/voice-studio/.venv/bin/python -m uvicorn backend:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/voice-studio/data /srv/voice-studio/models
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
