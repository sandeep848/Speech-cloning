# Copy to backend/.env. Existing shell environment values take precedence.
# requirements.txt installs model libraries; weights download on first load.
GENERATION_LANGUAGE=German
AUTO_EVALUATE=1
ENABLE_WHISPER=0
WHISPER_MODEL=base
ENABLE_ECAPA=0
ENABLE_SCOREQ=0
EVAL_DEVICE=cpu
MAX_PENDING_JOBS=12
MODEL_CACHE_VERSION=7
MAX_INTERNAL_PAUSE_MS=650
XTTS_REPETITION_PENALTY=10.0
XTTS_SPEED=1.0
# Set absolute paths when running API and workers from different directories.
# VOICE_STUDIO_DATA=/srv/voice-studio/data
# REFERENCE_DIR=/srv/voice-studio/reference
# COSY_MODEL_DIR=/srv/models/Fun-CosyVoice3-0.5B
# MODEL_DEVICE=cuda:0
# API_TOKEN=replace-with-a-long-random-token
# ADMIN_TOKEN=replace-with-a-different-long-random-token
# COOKIE_SECURE=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
