# Copy to backend/.env. Existing shell environment values take precedence.
# No model libraries/weights are installed by backend/requirements.txt.
GENERATION_LANGUAGE=German
AUTO_EVALUATE=1
ENABLE_WHISPER=0
WHISPER_MODEL=base
ENABLE_ECAPA=0
ENABLE_SCOREQ=0
EVAL_DEVICE=cpu
MAX_PENDING_JOBS=12
INFERENCE_TIMEOUT=600
MODEL_CACHE_VERSION=1
# Set absolute paths when running API and workers from different directories.
# VOICE_STUDIO_DATA=/srv/voice-studio/data
# REFERENCE_DIR=/srv/voice-studio/reference
# COSY_MODEL_DIR=/srv/models/Fun-CosyVoice3-0.5B
# MODEL_DEVICE=cuda:0
# Leave URLs unset to use installed local adapters. Set individually to isolate dependencies.
# WORKER_QWEN3_URL=http://127.0.0.1:8101
# WORKER_COSYVOICE3_URL=http://127.0.0.1:8102
# WORKER_XTTS_V2_URL=http://127.0.0.1:8103
# WORKER_TOKEN=replace-with-a-long-random-token
# API_TOKEN=replace-with-a-long-random-token
# ADMIN_TOKEN=replace-with-a-different-long-random-token
# COOKIE_SECURE=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
