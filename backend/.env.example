# Secure defaults: private APIs remain locked until credentials are configured.
APP_ENV=development
AUTH_MODE=token
DEV_ALLOW_ANONYMOUS=0
# For private local development only: DEV_ALLOW_ANONYMOUS=1
# Production requires COOKIE_SECURE=1, HTTPS origins, and either:
# AUTH_MODE=token with API_TOKEN >=32 characters, or
# AUTH_MODE=accounts with AUTH_EPOCH and offline provisioned accounts.
# AUTH_EPOCH=replace-with-a-random-version-and-change-to-revoke-all-account-sessions
# Production secrets belong in service configuration, never in the repository.
MAX_USER_JOBS=6
MAX_STORED_JOBS=1000
# REPRODUCIBLE=1 serializes model calls; enables per-request seeds.
# Daily backup configuration (enable timer only after a successful restore drill):
# BACKUP_DIR=/srv/voice-studio/backups
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_COPY_ARGV=["rsync","--","{archive}","backup-host:/restricted/studio/"]
# BACKUP_RETENTION_DAYS=30
# Copy to backend/.env. Existing shell environment values take precedence.
# requirements.txt installs model libraries; weights download on first load.
GENERATION_LANGUAGE=German
AUTO_EVALUATE=1
ENABLE_WHISPER=0
WHISPER_MODEL=base
ENABLE_ECAPA=0
ENABLE_SCOREQ=0
EVAL_DEVICE=cpu
MAX_PENDING_JOBS=12
MODEL_CACHE_VERSION=9
MAX_INTERNAL_PAUSE_MS=650
XTTS_REPETITION_PENALTY=10.0
XTTS_SPEED=1.0
# Set absolute paths when running API and workers from different directories.
# VOICE_STUDIO_DATA=/srv/voice-studio/data
# REFERENCE_DIR=/srv/voice-studio/reference
# COSY_MODEL_DIR=/srv/models/Fun-CosyVoice3-0.5B
# MODEL_DEVICE=cuda:0
# API_TOKEN=replace-with-a-long-random-token
# ADMIN_TOKEN=replace-with-a-different-long-random-token
# COOKIE_SECURE=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gentle speed adjustment (native controls for Cosy/XTTS); 1.0 keeps native speed.
QWEN_SPEECH_RATE=0.92
COSY_SPEECH_RATE=0.96
XTTS_SPEECH_RATE=0.96
COMMA_PAUSE_MS=150
SENTENCE_PAUSE_MS=320
PARAGRAPH_PAUSE_MS=600
CONTINUATION_PAUSE_MS=90

# Qwen batches later phrases on CUDA (2 by default); CPU uses 1.
# Set 1 if GPU memory is tight. First phrase always generates separately.
# QWEN_BATCH_SIZE=2
# QWEN_ATTN_IMPLEMENTATION=sdpa
# Optional accelerated Cosy backends require compatible, separately installed dependencies/artifacts.
COSY_LOAD_TRT=0
COSY_LOAD_VLLM=0

# Production requires supervised processes. Thread mode is for development/tests.
INFERENCE_ISOLATION=process
GENERATION_TIMEOUT_SECONDS=600
EVALUATION_TIMEOUT_SECONDS=600
MODEL_LOAD_TIMEOUT=600
MAX_OUTPUT_BYTES=67108864
MAX_OUTPUT_SECONDS=600
MAX_USER_STORAGE_BYTES=1073741824
MAX_STORAGE_BYTES=10737418240
MIN_FREE_STORAGE_BYTES=67108864
MAX_EXPORT_BYTES=268435456
